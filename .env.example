# CipherMesh Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or service role keys to version control.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional STUN / TURN Server Configuration (JSON array of RTCIceServer objects)
# Defaults to public STUN servers if omitted; configure TURN credentials for strict symmetric NAT environments.
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"},{"urls":"stun:stun.cloudflare.com:3478"}]
